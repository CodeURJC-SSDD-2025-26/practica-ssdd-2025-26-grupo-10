      "name": "01. Autenticación (Auth)",
      "item": [
        {
          "name": "Login B2B (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Validar que el login ha sido exitoso (HTTP 200 OK)\r",
                  "pm.test(\"Login OK: Status 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Extraer el JSON del cuerpo de la respuesta\r",
                  "var jsonData = pm.response.json();\r",
                  "\r",
                  "// Validar que el servidor nos devuelve el atributo 'token'\r",
                  "pm.test(\"Response contiene JWT\", function () {\r",
                  "    pm.expect(jsonData).to.have.property(\"token\");\r",
                  "});\r",
                  "\r",
                  "// Guardar automáticamente el token en las variables de la colección\r",
                  "if (jsonData.token) {\r",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);\r",
                  "    console.log(\"El token JWT se ha guardado correctamente.\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
